{
  "name": "@afios/api",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.16.2"
  },
  "main": "src/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @afios/shared",
    "postinstall": "node scripts/ensure-shared-built.js",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "ensure:pm2": "node src/scripts/ensureSecondPm.js",
    "backfill:uat": "node src/scripts/backfillUatData.js",
    "backfill:stock-batches": "node src/scripts/backfillStockBatches.js",
    "backfill:material-prices": "node src/scripts/backfillMaterialReferencePrices.js",
    "seed:transactions": "node src/scripts/seedTransactionalDemo.js",
    "seed:registers": "node src/scripts/seedRegistersDemo.js",
    "uat:walk": "node src/scripts/uatSmokeWalk.js",
    "import:po-index": "node src/scripts/importPoIndex.js",
    "dedupe:materials": "node src/scripts/dedupeMaterials.js",
    "test": "node --test --test-concurrency=1 src/**/*.test.js"
  },
  "dependencies": {
    "@afios/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.19.1",
    "read-excel-file": "^9.3.14",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "write-excel-file": "^4.1.1"
  }
}
